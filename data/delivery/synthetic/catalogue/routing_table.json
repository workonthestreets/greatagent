  "graph": {
    "nodes": [
      "load_and_cut",
      "normalize",
      "extract_params",
      "owner_resolver",
      "risk_screen",
      "policy_gate",
      "decide",
      "critic",
      "draft",
      "human_gate",
      "emit"
    ],
    "edges": [
      {
        "from": "extract_params",
        "to": "owner_resolver",
        "when": "always"
      },
      {
        "from": "owner_resolver",
        "to": "risk_screen",
        "when": "owner_org_type resolved (Context names it)"
      },
      {
        "from": "risk_screen",
        "to": "human_gate",
        "when": "'safety' in risk_flags"
      },
      {
        "from": "risk_screen",
        "to": "policy_gate",
        "when": "otherwise"
      },
      {
        "from": "policy_gate",
        "to": "decide",
        "when": "allowed_actions narrowed by (issue_type, owner_org_type, customer_input_required, money_involved)"
      },
      {
        "from": "decide",
        "to": "critic",
        "when": "always"
      },
      {
        "from": "critic",
        "to": "decide",
        "when": "violation and retries < 2"
      },
      {
        "from": "critic",
        "to": "human_gate",
        "when": "human_gate in (soft, hard) or retries exhausted"
      },
      {
        "from": "critic",
        "to": "draft",
        "when": "pass"
      },
      {
        "from": "draft",
        "to": "emit",
        "when": "always"
      }
    ],
    "channel_rule": {
      "customer": "Customer portal; Call transcript if urgency in (immediate, deadline_today)",
      "business_counterparty": "Business portal; Email if the person is named by the carrier",
      "carrier": "Email by default; the originating work queue / chat when the request arrived there; Safety incident queue for safety",
      "merchant": "Email; Warehouse work queue when the request arrived there",
      "pickup_point": "Email",
      "international_carrier": "Email"
    },
    "action_rule": [
      {
        "if": "'safety' in risk_flags",
        "then": "escalate_safety"
      },
      {
        "if": "customer_input_required and owner_org_type == customer",
        "then": "ask_customer"
      },
      {
        "if": "customer_input_required and owner_org_type == business_counterparty",
        "then": "ask_counterparty"
      },
      {
        "if": "customer_input_required and owner_org_type == carrier (carrier must present the options)",
        "then": "request_options_for_customer"
      },
      {
        "if": "evidence_conflict or (money_involved and a credit/charge decision is requested)",
        "then": "request_review_or_investigation"
      },
      {
        "if": "owner_org_type == merchant and the merchant must approve/decide (replacement, exchange, reshipment, duplicate, refund review)",
        "then": "request_authorisation_or_decision"
      },
      {
        "if": "issue_type == tracking_visibility and the goods must be physically located or a scan is missing",
        "then": "request_physical_trace"
      },
      {
        "if": "the owner holds a record, reference, approved wording or itemisation the customer needs",
        "then": "request_record_or_statement"
      },
      {
        "else": "request_operator_action (execute within stated policy: rebook, hold, redirect, transfer, recover, collect, issue label/token, book crew, stop dispatch)"
      }
    ]
  }
}