# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional
# DESK_MODEL=claude-opus-5-5          # primary model; falls back automatically
# DESK_MODELS=claude-opus-5-5,claude-sonnet-5-5
# DESK_WORKERS=6
# DESK_MAX_REVISIONS=2
# DESK_SIM_FAIL_RATE=0                # inject transient tool failures (0..1) to test recovery
# DESK_SIM_FAIL_CHANNELS=             # e.g. "Email" to simulate a channel outage

# ---- Live desk (hub + Managed Agent + Supabase), see hub/README.md
# for "open trace" links; the ID from the Console URL
ANTHROPIC_WORKSPACE_ID=default
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase session pooler URI (postgres://postgres.<ref>:<pw>@...:5432/postgres)
DATABASE_URL=
# comma-separated Google emails that become admin on sign-up
ADMIN_EMAILS=
# password for the seeded demo accounts
DEMO_PASSWORD=greatagent-demo
# optional: maps your phone to the demo customer for voice tests
DEMO_CUSTOMER_PHONE=
# https://<tunnel>.trycloudflare.com (no trailing slash)
HUB_PUBLIC_URL=
# openssl rand -hex 32
HUB_MCP_TOKEN=
# openssl rand -hex 32; ElevenLabs sends it as X-Hub-Secret
HUB_WEBHOOK_SECRET=
# which agent works the cases: managed (Managed Agents) or pipeline (planner -> lint -> reviewer)
# DESK_ENGINE=managed
# AGENT_MODEL=claude-sonnet-5-5
# hard cap per case session
# AGENT_SESSION_BUDGET_CENTS=150
# tools that wait for Approve/Reject in /ops
# AGENT_APPROVAL_TOOLS=send_message
# AGENT_AUTO_APPROVE=0
# local testing: accept X-Dev-User: <email> on /api
# HUB_DEV_AUTH=0
