# v2 stack (api_v2 + deskagent_v1_1 + preprocess, serving the built web_v2) for Railway or any Docker host.
# Build from the repo root:   docker build -f deploy/Dockerfile.v2 .
FROM node:20-alpine AS web
WORKDIR /web
COPY web_v2/package.json web_v2/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web_v2/ ./
# Optional; only when api_v2 runs with V2_API_TOKEN. Railway passes a service variable of this name as the build arg.
ARG VITE_V2_API_TOKEN
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY deskagent/ deskagent/
COPY deskagent_v1_1/ deskagent_v1_1/
COPY preprocess/ preprocess/
COPY api_v2/ api_v2/
COPY cases/ cases/
# api_v2 serves web_v2/dist from the same origin when the folder exists.
COPY --from=web /web/dist web_v2/dist

RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

EXPOSE 8100
CMD ["sh", "-c", "exec uvicorn api_v2.app:app --host 0.0.0.0 --port ${PORT:-8100}"]
